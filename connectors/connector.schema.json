{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kervik.local/schemas/connector.schema.json",
  "title": "Kervik connector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "apiVersion",
    "kind",
    "publisher",
    "engines",
    "runtime",
    "name",
    "description",
    "icon",
    "provides"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "apiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "enum": ["cloud", "device", "self-hosted"] },
    "publisher": { "type": "string", "minLength": 1 },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kervik"],
      "properties": {
        "kervik": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ezcloud": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["builtin", "native"] },
        "entrypoint": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "builtin" } } },
          "then": {
            "required": ["entrypoint"],
            "properties": {
              "entrypoint": { "pattern": "^host:[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        }
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1 },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]*(?:\\.[a-z][A-Za-z0-9-]*)+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
