{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kervik.local/schemas/addon.schema.json",
  "title": "Kervik add-on manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "publisher",
    "engines",
    "kind",
    "runtime",
    "requires",
    "name",
    "description",
    "icon",
    "category",
    "permissions",
    "contributes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publisher": { "type": "string", "minLength": 1 },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kervik"],
      "properties": {
        "kervik": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ezcloud": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "kind": { "enum": ["addon", "system"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["builtin", "declarative", "native"] },
        "entrypoint": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "builtin" } } },
          "then": {
            "required": ["entrypoint"],
            "properties": {
              "entrypoint": { "pattern": "^host:[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        }
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectors"],
      "properties": {
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "api"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "api": { "type": "string", "pattern": "^>=[0-9]+ <[0-9]+$" }
            }
          },
          "uniqueItems": true
        }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1 },
    "category": { "enum": ["DevOps", "DevSecOps", "AIOps", "FinOps"] },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]*(?:\\.[a-z][A-Za-z0-9-]*)+$" },
          "uniqueItems": true
        }
      }
    },
    "contributes": { "type": "object" }
  }
}
